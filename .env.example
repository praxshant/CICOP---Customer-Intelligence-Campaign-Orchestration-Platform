# Application Settings
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=cicop-secret-key-change-in-production-32bytes
JWT_SECRET_KEY=cicop-jwt-secret-key-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///backend/data/customer_insights.db
# For PostgreSQL: postgresql://user:password@localhost:5432/cicop_db

# ML Serving & API Gateway
ML_SERVING_URL=http://localhost:8001
GATEWAY_URL=http://localhost:8002
MODEL_DIR=backend/models

# Celery & Redis Worker Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Streamlit Dashboard Port
PORT=8501
